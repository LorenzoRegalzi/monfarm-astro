---
import Button from './Button.astro';

const motivoOptions = [
  { value: 'struttura-location', label: 'Struttura/location' },
  { value: 'operatore-insegnante', label: 'Operatore/insegnante' },
  { value: 'partecipare', label: 'Vorrei partecipare' },
  { value: 'altro', label: 'Altro' },
];

const selectPlaceholder = 'Cosa ti porta qui?';
---

<form
  class="contact-form stack stack--sm"
  method="POST"
  action="/api/contact"
  novalidate
  id="contact-form"
>
  <p hidden>
    <label>Non compilare: <input name="bot-field" /></label>
  </p>

  <input
    class="input-line"
    type="text"
    id="nome"
    name="nome"
    placeholder="Nome"
    autocomplete="given-name"
    required
    aria-required="true"
    aria-label="Nome"
  />

  <input
    class="input-line"
    type="text"
    id="cognome"
    name="cognome"
    placeholder="Cognome"
    autocomplete="family-name"
    required
    aria-required="true"
    aria-label="Cognome"
  />

  <input
    class="input-line"
    type="email"
    id="email"
    name="email"
    placeholder="Mail"
    autocomplete="email"
    required
    aria-required="true"
    aria-label="Mail"
  />

  <div class="select" data-select data-select-placeholder={selectPlaceholder}>
    <button
      type="button"
      class="select__trigger input-line"
      aria-haspopup="listbox"
      aria-expanded="false"
      aria-label={selectPlaceholder}
      id="motivo"
    >
      <span class="select__value is-placeholder" data-select-value>{selectPlaceholder}</span>
      <span class="select__arrow" aria-hidden="true">
        <svg width="14" height="9" viewBox="0 0 14 9" fill="none">
          <path d="M1 1L7 7L13 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
    </button>
    <ul class="select__menu" role="listbox" aria-label={selectPlaceholder} hidden>
      {motivoOptions.map((option) => (
        <li
          class="select__option"
          role="option"
          data-value={option.value}
          tabindex="-1"
        >
          {option.label}
        </li>
      ))}
    </ul>
    <input type="hidden" name="motivo" value="" required aria-required="true" data-select-input />
  </div>

  <div class="field">
    <label class="text-form-label" for="messaggio">Messaggio</label>
    <textarea
      class="input-box"
      id="messaggio"
      name="messaggio"
      rows="7"
      required
      aria-required="true"
    ></textarea>
  </div>

  <label class="field-checkbox" for="privacy">
    <input
      class="field-checkbox__input"
      type="checkbox"
      id="privacy"
      name="privacy"
      required
      aria-required="true"
      aria-describedby="privacy-desc"
    />
    <span class="text-form-label" id="privacy-desc">
      Accetto la
      <a href="/privacy-policy" target="_blank" rel="noopener noreferrer">privacy policy</a>
    </span>
  </label>

  <div class="stack stack--center">
    <Button text="Invia messaggio" type="submit" />
  </div>

  <p class="contact-form__success" role="alert" hidden>
    Grazie! Ti risponderemo al più presto.
  </p>
  <p class="contact-form__error" role="alert" hidden>
    Si è verificato un errore. Riprova o scrivici direttamente su Instagram.
  </p>
</form>

<style>
.contact-form {
  max-width: 520px;
  margin-inline: auto;
}

.contact-form__success {
  text-align: center;
  color: var(--color-olive);
  font-weight: 600;
}

.contact-form__error {
  text-align: center;
  color: var(--color-terracotta);
}
</style>

<script>
  function initSelect(root: HTMLElement) {
    const trigger = root.querySelector('.select__trigger') as HTMLButtonElement;
    const menu = root.querySelector('.select__menu') as HTMLUListElement;
    const valueEl = root.querySelector('[data-select-value]') as HTMLSpanElement;
    const hiddenInput = root.querySelector('[data-select-input]') as HTMLInputElement;
    const options = Array.from(root.querySelectorAll('.select__option')) as HTMLLIElement[];
    const placeholder = root.dataset.selectPlaceholder ?? '';

    function closeMenu() {
      root.classList.remove('is-open');
      trigger.setAttribute('aria-expanded', 'false');
      menu.hidden = true;
    }

    function openMenu() {
      root.classList.add('is-open');
      trigger.setAttribute('aria-expanded', 'true');
      menu.hidden = false;
    }

    function resetValue() {
      hiddenInput.value = '';
      valueEl.textContent = placeholder;
      valueEl.classList.add('is-placeholder');
      options.forEach((item) => {
        item.classList.remove('is-selected');
        item.setAttribute('aria-selected', 'false');
      });
    }

    function selectOption(option: HTMLLIElement) {
      const value = option.dataset.value ?? '';
      const label = option.textContent?.trim() ?? '';

      hiddenInput.value = value;
      valueEl.textContent = label;
      valueEl.classList.remove('is-placeholder');

      options.forEach((item) => {
        item.classList.toggle('is-selected', item === option);
        item.setAttribute('aria-selected', item === option ? 'true' : 'false');
      });

      closeMenu();
      trigger.focus();
    }

    trigger.addEventListener('click', () => {
      menu.hidden ? openMenu() : closeMenu();
    });

    options.forEach((option, index) => {
      option.setAttribute('aria-selected', 'false');
      option.addEventListener('click', () => selectOption(option));
      option.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          selectOption(option);
        }
        if (event.key === 'ArrowDown') {
          event.preventDefault();
          (options[index + 1] ?? options[0])?.focus();
        }
        if (event.key === 'ArrowUp') {
          event.preventDefault();
          (options[index - 1] ?? options[options.length - 1])?.focus();
        }
        if (event.key === 'Escape') {
          closeMenu();
          trigger.focus();
        }
      });
    });

    document.addEventListener('click', (event) => {
      if (!root.contains(event.target as Node)) closeMenu();
    });

    root.addEventListener('select:reset', resetValue);
  }

  document.querySelectorAll('[data-select]').forEach((select) => {
    initSelect(select as HTMLElement);
  });

  const form = document.getElementById('contact-form') as HTMLFormElement;
  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const successMsg = form.querySelector('.contact-form__success') as HTMLElement;
      const errorMsg = form.querySelector('.contact-form__error') as HTMLElement;
      const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;

      btn.disabled = true;
      btn.textContent = 'Invio in corso…';

      try {
        const res = await fetch('/api/contact', {
          method: 'POST',
          body: new FormData(form),
        });
        const json = await res.json();

        if (res.ok && json.ok) {
          form.reset();
          form.querySelectorAll('[data-select]').forEach((select) => {
            select.dispatchEvent(new CustomEvent('select:reset'));
          });
          successMsg.hidden = false;
          errorMsg.hidden = true;
        } else {
          throw new Error(json.error ?? 'Server error');
        }
      } catch {
        errorMsg.hidden = false;
        successMsg.hidden = true;
        btn.disabled = false;
        btn.textContent = 'Invia messaggio';
      }
    });
  }
</script>
