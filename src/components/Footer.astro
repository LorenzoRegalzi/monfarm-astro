---
import SectionDivider from "./SectionDivider.astro";

const year = new Date().getFullYear();
---

<footer class="site-footer">

  <div class="footer-body">
    <div class="container footer-body__inner stack stack--lg stack--center">

      <a href="/" class="footer-logo">
        <img src="/images/logo.svg" alt="MonFarm Experience" width="160" height="70" loading="lazy" />
      </a>

      <div class="footer-mid">
        <p class="text-lead">
          Un format di esperienze immersive nella natura, nato per creare
          <strong>connessioni autentiche</strong>.
        </p>

        <nav class="footer-nav" aria-label="Navigazione footer">
          <ul class="stack stack--flush" role="list">
            <li><a href="/" class="text-label">Home</a></li>
            <li><a href="/il-format" class="text-label">Il Format</a></li>
            <li><a href="/a-chi-e-rivolto" class="text-label">A chi è rivolto</a></li>
            <li><a href="/esperienze" class="text-label">Esperienze</a></li>
            <li><a href="/collabora" class="text-label">Collabora</a></li>
          </ul>
        </nav>
      </div>

      <ul class="footer-contacts stack stack--sm stack--left" role="list">
        <li class="footer-contacts__item text-label">
          <svg class="footer-contacts__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10"/>
            <path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
          </svg>
          <span>www.monfarmexperience.it</span>
        </li>
        <li class="footer-contacts__item text-label">
          <svg class="footer-contacts__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="5" y="2" width="14" height="20" rx="2"/>
            <circle cx="12" cy="17" r="1"/>
          </svg>
          <span>+39 3209318074</span>
        </li>
        <li class="footer-contacts__item text-label">
          <svg class="footer-contacts__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"/>
            <circle cx="12" cy="9" r="2.5"/>
          </svg>
          <span>Casale Monferrato<br />15033 (AL)</span>
        </li>
      </ul>

    </div>
  </div>

  <SectionDivider />

  <div class="footer-community">
    <div class="container footer-community__inner stack stack--lg stack--center">
      <h2 class="text-display text-display--lg">Entra nella community<br />MonFarm Experience!</h2>
      <div class="footer-social">
        <a
          href="https://www.instagram.com/monfarmexperience"
          target="_blank"
          rel="noopener noreferrer"
          class="footer-social__icon"
          aria-label="MonFarm Experience su Instagram"
        >
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
          </svg>
        </a>
        <a
          href="https://www.facebook.com/monfarmexperience"
          target="_blank"
          rel="noopener noreferrer"
          class="footer-social__icon"
          aria-label="MonFarm Experience su Facebook"
        >
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
          </svg>
        </a>
        <a
          href="https://www.tiktok.com/@monfarmexperience"
          target="_blank"
          rel="noopener noreferrer"
          class="footer-social__icon"
          aria-label="MonFarm Experience su TikTok"
        >
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1V9.01a6.32 6.32 0 0 0-.79-.05 6.34 6.34 0 0 0-6.34 6.34 6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.33-6.34V8.69a8.18 8.18 0 0 0 4.78 1.52V6.73a4.85 4.85 0 0 1-1.01-.04z"/>
          </svg>
        </a>
      </div>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container footer-bottom__inner stack stack--center">
      <p>&copy; {year} MonFarm Experience</p>
      <p>
        <a href="/privacy-policy">Privacy Policy</a>
        &nbsp;·&nbsp;
        <a href="/privacy-policy">Cookie Policy</a>
      </p>
    </div>
  </div>

</footer>

<style>
.footer-body {
  background-color: var(--color-cream-bg);
  padding-block: var(--space-xl);
}

.footer-body__inner {
  width: 100%;
}

.footer-logo img {
  height: 56px;
  width: auto;
}

.footer-mid {
  display: flex;
  align-items: stretch;
  justify-content: space-between;
  gap: var(--space-lg);
  width: 100%;
}

.footer-mid > .text-lead {
  flex: 1;
  max-width: 58%;
  text-align: left;
  margin: 0;
}

.footer-mid .text-lead strong {
  font-weight: 500;
}

.footer-nav {
  flex: 1;
  max-width: 42%;
  display: flex;
  flex-direction: column;
}

.footer-nav .stack {
  list-style: none;
  align-items: flex-end;
  flex: 1;
  justify-content: space-between;
  height: 100%;
}

.footer-nav a {
  font-weight: 400;
  text-decoration: none;
  line-height: 1.35;
  transition: color var(--transition);
}

.footer-nav a:hover {
  color: var(--color-brown);
}

.footer-contacts {
  list-style: none;
  width: 100%;
}

.footer-contacts .text-label {
  font-size: clamp(0.95rem, 2.8vw, 1.15rem);
  font-weight: 400;
}

.footer-contacts__item {
  display: flex;
  align-items: flex-start;
  gap: 0.75rem;
}

.footer-contacts__icon {
  width: 30px;
  height: 30px;
  flex-shrink: 0;
  margin-top: 0.1rem;
  color: var(--color-text-light);
}

.footer-community {
  padding-block: var(--space-xl);
}

.footer-social {
  display: flex;
  gap: var(--space-md);
  align-items: center;
}

.footer-social__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 52px;
  height: 52px;
  border-radius: 50%;
  background-color: var(--color-brown);
  color: var(--color-cream-bg);
  text-decoration: none;
  transition: opacity var(--transition), transform var(--transition);
}

.footer-social__icon svg {
  width: 26px;
  height: 26px;
}

.footer-social__icon:hover {
  opacity: 0.8;
  transform: translateY(-2px);
}

.footer-bottom {
  background-color: var(--color-olive);
  padding-block: var(--space-md);
}

.footer-bottom p {
  font-size: 0.8rem;
  color: var(--color-cream-bg);
  opacity: 0.9;
}

.footer-bottom a {
  color: var(--color-cream-bg);
  text-decoration: underline;
  opacity: 0.8;
  transition: opacity var(--transition);
}

.footer-bottom a:hover {
  opacity: 1;
}
</style>
