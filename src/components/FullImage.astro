---
interface Props {
  src: string;
  alt: string;
  height?: string;
  round?: boolean;
  loading?: 'lazy' | 'eager';
}

const { src, alt, height = '50vh', round = false, loading = 'lazy' } = Astro.props;
---

<div
  class:list={['full-image', { 'full-image--round': round }]}
  style={!round ? `height: ${height};` : undefined}
>
  <img
    src={src}
    alt={alt}
    loading={loading}
    decoding="async"
  />
</div>
