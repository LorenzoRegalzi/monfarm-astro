---
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<section class="page-header">
  <div class="container stack stack--center page-header__inner">
    <div class="page-header__top">
      <img
        src="/images/lotus.svg"
        alt="MonFarm Experience"
        class="page-header__logo"
        loading="eager"
      />
    </div>

    <h1 class="text-title">{title}</h1>
  </div>
</section>

<style>
.page-header {
  background-color: var(--color-cream-bg);
  padding-top: var(--space-sm);
}

.page-header__top {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-md);
}

.page-header__logo {
  height: 42px;
  width: auto;
}
</style>
