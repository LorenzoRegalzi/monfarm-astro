---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<section class="page-header">
  <div class="container stack stack--center page-header__inner">
    <img
      src="/images/lotus.svg"
      alt=""
      class="page-header__mark"
      width="56"
      height="42"
      loading="eager"
      aria-hidden="true"
    />
    <h1 class="text-title">{title}</h1>
  </div>
</section>

<style>
.page-header {
  background-color: var(--color-cream-bg);
  padding-top: var(--space-md);
  padding-bottom: var(--space-sm);
}

.page-header__inner {
  gap: var(--space-sm);
}

.page-header__mark {
  width: 3.5rem;
  height: auto;
  display: block;
}
</style>
