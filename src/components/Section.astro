---
interface Props {
  bg?: 'olive';
  compact?: boolean;
}

const { bg, compact = false } = Astro.props;
---

<section class:list={[
  'section',
  {
    'section--olive': bg === 'olive',
    'section--tight': compact,
  },
]}>
  <div class="container stack section__inner">
    <slot />
  </div>
</section>
