---
interface Props {
  bg?: 'olive' | 'olive-light' | 'olive-dark';
  align?: 'left';
}

const { bg, align } = Astro.props;
---

<section class:list={[
  'section-center section--compact',
  {
    'section-center--olive': bg === 'olive',
    'section-center--olive-light': bg === 'olive-light',
    'section-center--olive-dark': bg === 'olive-dark',
  },
]}>
  <div class:list={[
    'container stack stack--md',
    align === 'left' ? 'stack--left' : 'stack--center',
  ]}>
    <slot />
  </div>
</section>
