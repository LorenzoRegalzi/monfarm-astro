---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import ContactForm from '../components/ContactForm.astro';
import SectionCenter from '../components/SectionCenter.astro';
import SectionDivider from '../components/SectionDivider.astro';
import FullImage from '../components/FullImage.astro';
---

<Layout
  title="Contatti"
  description="Contatta MonFarm Experience: sei una struttura, un operatore o vuoi partecipare? Scrivici, ti risponderò personalmente."
>
  <PageHeader title="Contatti" />

  <SectionCenter align="left">
    <p class="text-lead">
      Se senti che MonFarm Experience potrebbe essere in sintonia con il tuo
      spazio, il tuo lavoro o il tuo percorso, scrivimi.
    </p>
    <p class="text-lead--italic">
      Ogni collaborazione nasce da una conversazione.
    </p>
    <p class="text-lead">
      Raccontami chi sei, cosa fai e cosa ti piacerebbe costruire insieme.
    </p>
    <p class="text-lead--olive">
      Ti risponderò <strong>personalmente</strong>.
    </p>
  </SectionCenter>

  <FullImage
    src="/images/contatti/contatti-1.webp"
    alt="Beatrice Furia sorridente in un prato durante un'esperienza MonFarm"
    height="var(--image-tall-height)"
  />

  <section class="section">
    <div class="container">
      <ContactForm />
    </div>
  </section>

  <SectionDivider />

  <SectionCenter>
    <p class="text-display text-display--md">
      MonFarm Experience è un <em>progetto relazionale</em>:
      ogni incontro è il punto di partenza.
    </p>
  </SectionCenter>

  <FullImage
    src="/images/contatti/contatti-2.webp"
    alt="Ritratto di Beatrice Furia, fondatrice di MonFarm Experience"
    height="var(--image-mid-height)"
  />

  <SectionCenter>
    <p class="text-intro text-intro--olive">
      Preferisci scrivere direttamente?<br />
      <a href="mailto:info@monfarmexperience.it">info@monfarmexperience.it</a>
    </p>
  </SectionCenter>
</Layout>
